# Copy to `.env` and fill in your secrets.
#
# For local dev, ports/URLs/Postgres/S3/Redis/Inngest are auto-generated into
# `.env.local` by `crbn up` where supported. Vite/React Router auto-loads
# `.env.local` on top of `.env`, so only set genuine secrets here.

# Carbon
AUTH_PROVIDERS="email,google" # "email" | "google" | "azure"
AUTH_PROVIDER="better_auth"
BETTER_AUTH_SECRET="************************"
CARBON_EDITION="community" # "community" | "cloud" | "enterprise"
SESSION_SECRET="************************"
RATE_LIMIT="5"

CLOUDFLARE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
CLOUDFLARE_TURNSTILE_SECRET_KEY="********************"

DOMAIN="localhost"
ERP_URL="http://localhost:3000"
MES_URL="http://localhost:3001"
CARBON_FUNCTIONS_URL="http://localhost:3000"
CARBON_FUNCTIONS_TOKEN=""

# Postgres
# Optional owner/admin URL for schema migrations; app runtime should use the two scoped URLs below.
DATABASE_MIGRATION_URL="postgresql://carbon:carbon@localhost:5432/carbon"
DATABASE_URL="postgresql://carbon_app:carbon_app@localhost:5432/carbon"
DATABASE_SERVICE_URL="postgresql://carbon_service:carbon_service@localhost:5432/carbon"
JOBS_DATABASE_URL="postgresql://carbon_service:carbon_service@localhost:5432/carbon"

# S3-compatible object storage
S3_REGION="auto"
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="carbon"
S3_SECRET_ACCESS_KEY="carbon-password"
S3_PRIVATE_BUCKET="carbon-private-local"
S3_PUBLIC_BUCKET="carbon-public-local"
S3_PUBLIC_BASE_URL="http://localhost:9000/carbon-public-local"

# OAuth
GOOGLE_CLIENT_ID="************.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-****************************"
AZURE_CLIENT_ID="***************************************"
AZURE_CLIENT_SECRET="***********************************"

# Posthog
POSTHOG_API_HOST="https://us.posthog.com"
POSTHOG_PROJECT_PUBLIC_KEY="********************"

# Stripe
STRIPE_SECRET_KEY="sk_test_*************"
STRIPE_WEBHOOK_SECRET="whsec_************"

# GTM (notifications fan-out)
GTM_EVENTS_API_SECRET_KEY=""

# Resend
RESEND_API_KEY="************************"
RESEND_DOMAIN="carbon.ms"
# RESEND_AUDIENCE_ID="*****" # Optional, required for contact management in `packages/jobs`

# Novu
NOVU_APPLICATION_ID="********************"
NOVU_SECRET_KEY="********************"

# Slack
SLACK_BOT_TOKEN="***********************"

# AI
ANTHROPIC_API_KEY="sk-ant-***************"
OPENAI_API_KEY="sk-proj-*****************"
EMBEDDING_MODEL="text-embedding-3-small"

# Google Places
GOOGLE_PLACES_API_KEY="*******************"

# External media services
THUMBNAIL_SERVICE_URL=""
THUMBNAIL_SERVICE_TOKEN=""
IMAGE_RESIZER_URL=""
TRANSCRIPTION_SERVICE_URL=""

# Inngest (production keys; dev mode flags are in .env.local)
# INNGEST_SIGNING_KEY="signkey-****-********************"
# INNGEST_EVENT_KEY="********************"
