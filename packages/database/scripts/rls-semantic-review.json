{
  "profiles": {
    "app-layer-permission-gate": {
      "description": "The greenfield RLS contract enforces tenant/principal isolation in Postgres. Module/action authorization from these legacy policies is intentionally enforced before query execution by Better Auth claims, API-key scopes, and route/service permission gates.",
      "evidence": [
        "packages/auth/src/services/auth.server.ts",
        "packages/auth/src/services/users.ts",
        "packages/database/src/drizzle.ts",
        "packages/database/src/query-client.ts"
      ]
    },
    "document-app-gate": {
      "description": "Document row isolation is handled by generated tenant RLS. Document module permissions, read/write group UX, and file access are enforced by app routes/components and direct S3 download/upload routes.",
      "evidence": [
        "packages/auth/src/services/auth.server.ts",
        "apps/erp/app/routes/x+/documents+/search.tsx",
        "apps/erp/app/routes/x+/documents+/search.$documentId.tsx",
        "apps/erp/app/routes/x+/documents+/$documentId.delete.tsx",
        "apps/erp/app/routes/file+/preview+/image.tsx",
        "packages/storage/src/path.ts"
      ]
    },
    "external-account-app-gate": {
      "description": "Customer/supplier account ownership semantics are app-layer authorization concerns in the greenfield target. Tenant RLS bounds company data; account-specific customer/supplier access is resolved through user account rows and module permission gates.",
      "evidence": [
        "packages/auth/src/services/auth.server.ts",
        "packages/auth/src/services/users.server.ts",
        "apps/erp/app/modules/users/users.server.ts",
        "apps/erp/app/modules/users/users.service.ts"
      ]
    },
    "users-admin-app-gate": {
      "description": "User and employee-type permission administration is protected by the users module permission gates and Better Auth session/API-key authorization before the database call.",
      "evidence": [
        "packages/auth/src/services/auth.server.ts",
        "apps/erp/app/modules/users/users.server.ts",
        "apps/erp/app/modules/users/users.service.ts",
        "apps/erp/app/modules/users/ui/EmployeeTypes/EmployeeTypesTable.tsx",
        "apps/erp/app/modules/users/ui/Employees/EmployeesTable.tsx"
      ]
    }
  },
