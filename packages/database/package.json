{
  "name": "@carbon/database",
  "devDependencies": {
    "@carbon/config": "workspace:*",
    "@types/node": "20.19.39",
    "@types/pg": "8.15.6",
    "@types/uuid": "8.3.4",
    "dotenv": "16.3.1",
    "drizzle-kit": "^0.31.9",
    "npm-run-all": "catalog:",
    "rimraf": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "uuid": "9.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./convert": "./src/convert.ts",
    "./create": "./src/create.ts",
    "./drizzle": "./src/drizzle.ts",
    "./get-method": "./src/get-method.ts",
    "./import-csv": "./src/import-csv.ts",
    "./issue": "./src/issue.ts",
    "./mrp": "./src/mrp.ts",
    "./post-purchase-invoice": "./src/post-purchase-invoice.ts",
    "./post-receipt": "./src/post-receipt.ts",
    "./post-sales-invoice": "./src/post-sales-invoice.ts",
    "./post-shipment": "./src/post-shipment.ts",
    "./post-stock-transfer": "./src/post-stock-transfer.ts",
    "./postgres": "./src/postgres.ts",
    "./query-client": "./src/query-client.ts",
    "./schema": "./src/schema/index.ts",
    "./recalculate": "./src/recalculate.ts",
    "./schedule": "./src/schedule.ts",
    "./seed-company": "./src/seed-company.ts",
    "./sync": "./src/sync.ts",
    "./event": "./src/event.ts",
    "./ratelimit": "./src/ratelimit.ts",
    "./audit": "./src/audit.ts",
    "./audit.config": "./src/audit.config.ts",
    "./audit.types": "./src/audit.types.ts",
    "./api-docs-schema": "./src/api-docs-schema.ts"
  },
  "private": true,
  "scripts": {
    "clean": "rimraf .turbo node_modules dist",
    "db:diff": "drizzle-kit check --config drizzle.config.ts",
    "db:init": "drizzle-kit generate --config drizzle.config.ts",
    "db:kill": "docker compose rm -sf postgres",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:migrate:new": "drizzle-kit generate --config drizzle.config.ts",
    "db:seed": "tsx src/seed.ts",
    "db:seed:dev": "tsx src/seed-dev.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:start": "docker compose up -d postgres minio createbuckets",
    "db:stop": "docker compose stop postgres minio",
    "db:audit:auth-provider": "node scripts/audit-auth-provider.mjs",
    "db:audit:declarative-schema": "node scripts/audit-declarative-schema.mjs",
    "db:audit:rls": "node scripts/audit-rls.mjs",
    "db:audit:rls:open": "node scripts/audit-rls.mjs --list-open",
    "db:audit:rls:review": "node scripts/audit-rls-semantic-review.mjs --list-review",
    "db:audit:rls:gates": "node scripts/audit-rls-app-gates.mjs",
    "db:audit:permissions": "node scripts/audit-permission-claims.mjs",
    "db:audit:rpc": "node scripts/audit-rpc-functions.mjs",
    "db:audit:function-routes": "node scripts/audit-function-routes.mjs",
    "db:audit:runtime-stack": "node scripts/audit-runtime-stack.mjs",
    "db:audit:schema": "node scripts/audit-schema.mjs",
    "db:audit:sql-portability": "node scripts/audit-sql-portability.mjs",
    "db:audit:storage": "node scripts/audit-storage.mjs",
    "db:audit:vendor-removal": "node scripts/audit-vendor-removal.mjs",
    "db:smoke:convert": "tsx scripts/smoke-convert.ts",
    "db:smoke:create": "tsx scripts/smoke-create.ts",
    "db:smoke:accounting-reporting": "node scripts/smoke-accounting-reporting-rpcs.mjs",
    "db:smoke:get-method": "tsx scripts/smoke-get-method.ts",
    "db:smoke:embedding-search": "node scripts/smoke-embedding-search.mjs",
    "db:smoke:import-csv": "tsx scripts/smoke-import-csv.ts",
    "db:smoke:inventory-quantities": "node scripts/smoke-inventory-quantities.mjs",
    "db:smoke:intercompany": "node scripts/smoke-intercompany-rpcs.mjs",
    "db:smoke:item-details": "node scripts/smoke-item-details.mjs",
    "db:smoke:issue": "tsx scripts/smoke-issue.ts",
    "db:smoke:job-completion": "node scripts/smoke-job-completion.mjs",
    "db:smoke:maintenance-location": "node scripts/smoke-maintenance-location-rpcs.mjs",
    "db:smoke:method-tree": "node scripts/smoke-method-tree-rpcs.mjs",
    "db:smoke:mes-runtime": "node scripts/smoke-mes-runtime.mjs",
    "db:smoke:mrp": "tsx scripts/smoke-mrp.ts",
    "db:smoke:post-purchase-invoice": "tsx scripts/smoke-post-purchase-invoice.ts",
    "db:smoke:post-receipt": "tsx scripts/smoke-post-receipt.ts",
    "db:smoke:post-sales-invoice": "tsx scripts/smoke-post-sales-invoice.ts",
    "db:smoke:post-shipment": "tsx scripts/smoke-post-shipment.ts",
    "db:smoke:planning-rpcs": "node scripts/smoke-planning-rpcs.mjs",
    "db:smoke:post-stock-transfer": "tsx scripts/smoke-post-stock-transfer.ts",
    "db:smoke:radan": "node scripts/smoke-radan-integration.mjs",
    "db:smoke:receipt-tracking": "node scripts/smoke-receipt-tracking-rpcs.mjs",
    "db:smoke:refresh-materialized-views": "node scripts/smoke-refresh-materialized-views.mjs",
    "db:smoke:related-record-lookups": "node scripts/smoke-related-record-lookups.mjs",
    "db:smoke:rls-context": "node scripts/smoke-rls-context.mjs",
    "db:smoke:recalculate": "tsx scripts/smoke-recalculate.ts",
    "db:smoke:schedule": "tsx scripts/smoke-schedule.ts",
    "db:smoke:seed-company": "tsx scripts/smoke-seed-company.ts",
    "db:smoke:storage-unit-requirements": "node scripts/smoke-storage-unit-requirements.mjs",
    "db:smoke:training-assignments": "node scripts/smoke-training-assignment-rpcs.mjs",
    "db:smoke:sync": "tsx scripts/smoke-sync.ts",
    "db:schema:generate": "pnpm run db:audit:declarative-schema",
    "db:types": "pnpm run db:audit:declarative-schema",
    "deploy": "npm run db:migrate",
    "lint": "biome lint --write ",
    "typecheck": "tsgo --noEmit"
  },
  "sideEffects": false,
  "version": "0.0.0",
  "dependencies": {
    "@carbon/storage": "workspace:*",
    "cookie": "catalog:",
    "csv-parse": "5.6.0",
    "dompurify": "catalog:",
    "drizzle-orm": "^0.45.1",
    "nanoid": "catalog:",
    "pg": "8.20.0",
    "react-pdf": "catalog:",
    "sst": "catalog:",
    "zod": "catalog:"
  }
}
